# Read Later configuration. Copy this file to .env (in this folder, the
# repository root) and fill it in. Next.js, the worker, the migrations and
# Docker Compose all read it. Never commit the real .env.
#
# On Vercel, set the same variables in Project Settings -> Environment
# Variables instead of using a file.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string.
# Neon: use the pooled connection string (the host contains "-pooler") and
# keep "?sslmode=require" at the end. Local Postgres:
# postgres://postgres:postgres@localhost:5432/readlater
DATABASE_URL=

# The public URL of the web app, without a trailing slash. Used for Google
# sign-in redirects, the instructions in Settings and the download User-Agent.
# Local development: http://localhost:3000
APP_URL=http://localhost:3000

# A long random secret that signs sign-in sessions. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Google OAuth client (see docs/setup/google-oauth.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in: Google account emails, separated by commas.
ALLOWED_EMAILS=

# Claude API key (see docs/setup/anthropic.md).
ANTHROPIC_API_KEY=

# The secret the Cloudflare Worker cron sends to /api/jobs/run. Generate one
# the same way as BETTER_AUTH_SECRET (use hex: .toString('hex')).
JOBS_SECRET=

# ---------------------------------------------------------------------------
# Optional. The values shown are the defaults.
# ---------------------------------------------------------------------------

# Default summary model for new users, until one is chosen in Settings:
# claude-opus-5-5, claude-sonnet-5-5 or claude-haiku-5-5.
# DEFAULT_SUMMARY_MODEL=claude-opus-5-5

# How hard Claude thinks while summarizing: low, medium, high, xhigh or max.
# SUMMARY_EFFORT=low

# Articles longer than this many characters are summarized from their
# beginning, and the summary is marked partial.
# SUMMARY_MAX_INPUT_CHARS=200000

# Run jobs right after each save with Next.js after(). Set to false when a
# worker process (pnpm worker) handles every job.
# RUN_JOBS_AFTER_RESPONSE=true

# How long one processJobs() call keeps picking up new jobs, and how many
# jobs it runs at once.
# JOBS_TIME_BUDGET_MS=240000
# JOBS_CONCURRENCY=3

# How often the worker process checks for new jobs.
# WORKER_POLL_MS=5000

# Limits for server-side page downloads.
# FETCH_TIMEOUT_MS=15000
# FETCH_MAX_BYTES=5242880

# Largest page HTML the extension or Shortcut may send (Vercel's limit for a
# request body is 4.5 MB).
# SAVE_MAX_HTML_BYTES=4194304

# Database connections per server process.
# DATABASE_POOL_MAX=5

# Only for local testing without a Claude API key: run `pnpm mock-claude` and
# set ANTHROPIC_BASE_URL=http://127.0.0.1:4010 and ANTHROPIC_API_KEY=mock.
# ANTHROPIC_BASE_URL=

# ---------------------------------------------------------------------------
# Docker Compose only (the one-server setup, see docs/move-to-server.md).
# There, DATABASE_URL is set by docker-compose.yml from POSTGRES_PASSWORD.
# ---------------------------------------------------------------------------

# Password for the Postgres container.
# POSTGRES_PASSWORD=

# Token of the Cloudflare Tunnel that publishes the app (no open ports).
# CLOUDFLARE_TUNNEL_TOKEN=
